rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Site admins are Auth users with custom claim admin == true.
    // That claim is granted only to the emails in functions/admins.js
    // by `npm run admin:claims` (functions/set-admin-claims.js).
    function isSiteAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function validSkuId(v) {
      return v is string && v.size() <= 64
        && v.matches('^(LT[0-9]{2}-(ELS|LOP|CHM|HLD)-[0-9]{2}-(DUN|FOIL)|LT[0-9]{2}-NS-(ELS|LOP|CHM)-[0-9]{2}-(DUN|FOIL)(-[A-Z]+)?|PIN-[A-Z0-9]{2,6}-[0-9]{2,3})$');
    }
    function validQuantity(v) { return v is int && v >= 0 && v <= 999; }
    function validNotes(d) { return !("notes" in d) || (d.notes is string && d.notes.size() <= 500); }
    function validTradeFlag(d) {
      return !("tradeFlag" in d) || d.tradeFlag == "iso" || d.tradeFlag == "uft";
    }
    function validCollectionEntry(d) {
      return d.keys().hasOnly(["ownerUid", "skuId", "quantity", "updatedAt", "notes", "tradeFlag"])
        && d.keys().hasAll(["ownerUid", "skuId", "quantity", "updatedAt"])
        && d.ownerUid is string
        && validSkuId(d.skuId)
        && validQuantity(d.quantity)
        && d.updatedAt is timestamp
        && validNotes(d)
        && validTradeFlag(d);
    }

    // Catalog SKUs use hyphens only (validSkuId); auto-ids and legacy sku-only paths have no underscore.
    // Block squatting on collections/{victimUid}_{sku} by requiring auth uid as the prefix.
    function collectionCreateEntryIdAllowed(entryId) {
      return !entryId.matches('^[^_]+_.*')
        || entryId.matches('^' + request.auth.uid + '_.*');
    }

    // Collections collection - user's card collection entries
    match /collections/{entryId} {
      allow read: if isSiteAdmin()
        || (signedIn() && request.auth.uid == resource.data.ownerUid);
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.ownerUid
        && validCollectionEntry(request.resource.data)
        && collectionCreateEntryIdAllowed(entryId);
      allow update: if signedIn()
        && request.auth.uid == resource.data.ownerUid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.skuId == resource.data.skuId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["quantity", "updatedAt", "notes", "skuId", "ownerUid", "tradeFlag"])
        && validQuantity(request.resource.data.quantity)
        && request.resource.data.updatedAt is timestamp
        && validNotes(request.resource.data)
        && validTradeFlag(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;
    }

    function contactSharingComplete(data) {
      return !("matchContactSharing" in data)
        || data.matchContactSharing == "trueEmail"
        || (data.matchContactSharing == "tradingEmail"
          && data.tradingEmail is string
          && data.tradingEmail.size() > 0)
        || (data.matchContactSharing == "discord"
          && data.discordHandle is string
          && data.discordHandle.size() > 0);
    }

    function validMatchLanes(data) {
      return !("matchLanes" in data)
        || (data.matchLanes is map
          && data.matchLanes.keys().hasOnly(["dun", "foil", "pins"])
          && (!("dun" in data.matchLanes) || data.matchLanes.dun is bool)
          && (!("foil" in data.matchLanes) || data.matchLanes.foil is bool)
          && (!("pins" in data.matchLanes) || data.matchLanes.pins is bool));
    }

    function validMatchKeepCount(value) {
      return value is int && value >= 1 && value <= 3;
    }

    function validMatchKeep(data) {
      return !("matchKeep" in data)
        || (data.matchKeep is map
          && data.matchKeep.keys().hasOnly(["dun", "foil", "pins"])
          && (!("dun" in data.matchKeep) || validMatchKeepCount(data.matchKeep.dun))
          && (!("foil" in data.matchKeep) || validMatchKeepCount(data.matchKeep.foil))
          && (!("pins" in data.matchKeep) || validMatchKeepCount(data.matchKeep.pins)));
    }

    // Optional ISO codes. Writes stay owner-only because the preferences doc is owner-only.
    function validMatchCountry(data) {
      return !("matchCountry" in data)
        || (data.matchCountry is string
          && (data.matchCountry == ""
            || (data.matchCountry.size() == 2 && data.matchCountry.matches('^[A-Z]{2}$'))));
    }

    function validMatchRegion(data) {
      return !("matchRegion" in data)
        || (data.matchRegion is string
          && (data.matchRegion == ""
            || (data.matchRegion.size() >= 4
              && data.matchRegion.size() <= 6
              && data.matchCountry is string
              && data.matchCountry.size() == 2
              && data.matchRegion.matches('^' + data.matchCountry + '-[A-Z0-9]{1,3}$'))));
    }

    function validShareId(id) {
      return id is string
        && id.size() >= 8
        && id.size() <= 32
        && id.matches('^[A-Za-z0-9_-]+$');
    }

    function validPublicShareIdField(data) {
      return !("publicShareId" in data)
        || validShareId(data.publicShareId);
    }

    function validUftItem(item) {
      return item.keys().hasOnly(["skuId", "quantity"])
        && validSkuId(item.skuId)
        && validQuantity(item.quantity)
        && item.quantity >= 1;
    }

    function validUftList(list) {
      return list is list
        && list.size() <= 500
        && (list.size() == 0 || (list[0] is map && validUftItem(list[0])));
    }

    function validIsoList(list) {
      return list is list
        && list.size() <= 500
        && (list.size() == 0 || (list[0] is string && validSkuId(list[0])));
    }

    function validShareSnapshot(data) {
      return data.keys().hasOnly([
          "ownerUid",
          "displayName",
          "iso",
          "uft",
          "updatedAt",
          "version",
          "discordHandle",
          "region",
          "revokedAt",
        ])
        && data.keys().hasAll(["ownerUid", "displayName", "iso", "uft", "updatedAt", "version"])
        && data.ownerUid is string
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 60
        && validIsoList(data.iso)
        && validUftList(data.uft)
        && data.updatedAt is timestamp
        && data.version is int
        && data.version == 1
        && (!("discordHandle" in data)
          || (data.discordHandle is string && data.discordHandle.size() <= 100))
        && (!("region" in data)
          || (data.region is string && data.region.size() <= 60))
        && (!("revokedAt" in data) || data.revokedAt is timestamp);
    }

    function validUserPreferences(data) {
      return (!("matchingOptOut" in data) || data.matchingOptOut is bool)
        && validMatchLanes(data)
        && validMatchKeep(data)
        && (!("matchContactSharing" in data)
          || data.matchContactSharing in ["trueEmail", "tradingEmail", "discord"])
        && (!("tradingEmail" in data)
          || (data.tradingEmail is string && data.tradingEmail.size() <= 320))
        && (!("discordHandle" in data)
          || (data.discordHandle is string && data.discordHandle.size() <= 100))
        && (!("discordChannel" in data)
          || (data.discordChannel is string && data.discordChannel.size() <= 100))
        && validMatchCountry(data)
        && validMatchRegion(data)
        && validPublicShareIdField(data)
        && contactSharingComplete(data);
    }

    // User preferences (single per-user doc)
    match /userPreferences/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && validUserPreferences(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Server-only (Admin SDK). Clients never read or write rate-limit state.
    match /rateLimits/{userId} {
      allow read, write: if false;
    }

    // Opt-in public ISO/UFT snapshots for /t/:shareId (ownerUid is world-readable).
    match /shares/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.ownerUid
        && validShareSnapshot(request.resource.data)
        && !exists(/databases/$(database)/documents/shares/$(shareId));
      allow update: if signedIn()
        && request.auth.uid == resource.data.ownerUid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && !("revokedAt" in resource.data)
        && validShareSnapshot(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
