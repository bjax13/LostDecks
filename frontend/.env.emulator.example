# Copy this entire file to frontend/.env for local emulator development:
#   cp frontend/.env.emulator.example frontend/.env
#
# Or from the repo root: npm run dev:local  (creates/repairs .env automatically)
#
# Vite only loads .env at process start — restart Vite after editing this file.
# Auth UI error "Authentication is not configured. Set VITE_FIREBASE_*" means
# one or more VITE_FIREBASE_* values below are missing or empty (including
# MEASUREMENT_ID). Any non-empty placeholder string works with emulators.

VITE_USE_EMULATORS=true

# Required Firebase Web SDK placeholders (all seven must be non-empty).
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-storydeck-16.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=storydeck-16
VITE_FIREBASE_STORAGE_BUCKET=demo-storydeck-16.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:demoabcdef
VITE_FIREBASE_MEASUREMENT_ID=G-DEMO000000

# Emulator hosts (defaults match firebase.json / Emulator Suite).
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_FUNCTIONS_EMULATOR_HOST=127.0.0.1
VITE_FUNCTIONS_EMULATOR_PORT=5001

# App Check (optional): emulators set a debug token automatically when App Check initializes.
# VITE_APPCHECK_RECAPTCHA_ENTERPRISE_SITE_KEY=
# VITE_APPCHECK_DEBUG_TOKEN=

# PostHog (optional): same as .env.example — omit or leave empty to skip analytics while using emulators.
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# VITE_POSTHOG_SURVEY_ID=
