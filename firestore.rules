rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Collections collection - user's card collection entries
    match /collections/{entryId} {
      allow read: if signedIn() && request.auth.uid == resource.data.ownerUid;
      allow create: if signedIn() && request.auth.uid == request.resource.data.ownerUid;
      allow update: if signedIn()
        && request.auth.uid == resource.data.ownerUid
        && request.auth.uid == request.resource.data.ownerUid;
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;
    }

    function contactSharingComplete(data) {
      return !("matchContactSharing" in data)
        || data.matchContactSharing == "trueEmail"
        || (data.matchContactSharing == "tradingEmail"
          && data.tradingEmail is string
          && data.tradingEmail.size() > 0)
        || (data.matchContactSharing == "discord"
          && data.discordHandle is string
          && data.discordHandle.size() > 0);
    }

    function validUserPreferences(data) {
      return (!("matchingOptOut" in data) || data.matchingOptOut is bool)
        && (!("matchContactSharing" in data)
          || data.matchContactSharing in ["trueEmail", "tradingEmail", "discord"])
        && (!("tradingEmail" in data)
          || (data.tradingEmail is string && data.tradingEmail.size() <= 320))
        && (!("discordHandle" in data)
          || (data.discordHandle is string && data.discordHandle.size() <= 100))
        && (!("discordChannel" in data)
          || (data.discordChannel is string && data.discordChannel.size() <= 100))
        && contactSharingComplete(data);
    }

    // User preferences (single per-user doc)
    match /userPreferences/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && validUserPreferences(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
