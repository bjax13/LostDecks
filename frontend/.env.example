# Firebase (Vite)
# Copy this file to .env and replace the placeholders with values from your Firebase project settings.
#
# Production deploys set VITE_FIREBASE_AUTH_DOMAIN to shardstash.web.app (not the
# sdkconfig default storydeck-16.firebaseapp.com). Local emulator auth ignores the
# Google account-chooser host. See scripts/productionAuthDomain.js.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Local Emulator Suite (optional) ---
# Set true to force Auth + Firestore to use local emulators.
VITE_USE_EMULATORS=false
# Defaults match Firebase Emulator Suite defaults.
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_FUNCTIONS_EMULATOR_HOST=127.0.0.1
VITE_FUNCTIONS_EMULATOR_PORT=5001

# --- PostHog (optional product analytics) ---
# Project API key from PostHog → Project settings. Leave empty to disable the SDK locally and in CI.
# Production: set VITE_POSTHOG_KEY and VITE_POSTHOG_HOST as GitHub repository secrets AND ensure
# deploy workflows (.github/workflows/deploy-*.yml) pass them into the deploy step env (see AGENTS.md).
# Local CLI deploys: export them in your shell or set them here before npm run deploy:hosting.
VITE_POSTHOG_KEY=
# US cloud default: https://us.i.posthog.com — use https://eu.i.posthog.com for EU projects.
VITE_POSTHOG_HOST=https://us.i.posthog.com
